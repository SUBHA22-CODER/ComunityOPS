# Database Connection (Default: SQLite for instant zero-dependency local dev; can be switched to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Next.js App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret Key for Ed25519 Certificate Authority / HMAC
CERTIFICATE_SIGNING_KEY="community-ops-master-ed25519-seed-2026-key"

# Python Optimization Service (OR-Tools CP-SAT)
OPTIMIZER_SERVICE_URL="http://localhost:8000"

# Redis & Outbox Worker Configuration
REDIS_URL="redis://localhost:6379"

# Notification Provider Keys (Optional / Simulator mode enabled by default)
RESEND_API_KEY=""
DISCORD_WEBHOOK_URL=""

# n8n Workflow Automation Engine
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_URL="http://localhost:5678/webhook/community-ops-events"
N8N_API_KEY=""
COMMUNITY_OPS_WEBHOOK_SECRET="community-ops-n8n-webhook-secret-2026"
